// LightSync DMX - CubeMap ゾーン積分 Compute Shader
//
// キューブマップ (リニアRGB) を立体角で正しく積分し、ゾーンごとの「正規化照度」を求める。
//
//   T_k = Σ L(ω) · m_k(ω) · g_k(ω) · dΩ
//
//   L     : texel の放射輝度 (リニアRGB)
//   dΩ    : texel の立体角 = 4 / (N² (1+u²+v²)^1.5)
//   m_k   : ゾーン k の所属度 (分割ゾーンは Σ m ≤ 1 になるよう正規化、除外コーンは 0)
//   g_k   : 形状ごとの重み。一様な放射輝度 1 の環境で T = 1 になるよう正規化してある
//             Irradiance / Cone / Key : max(0, ω·d) / π      (d 方向を向いた面の照度 / π)
//             Ring                   : sinθ / π²             (軸に垂直な面の照度を全方位で平均 / π)
//             Sphere                 : 1 / 4π                (全方位の平均放射輝度)
//
// パス構成 (面は SV_GroupID.z。6 面を 1 回のディスパッチで処理する):
//   MainPeakCS         (1,1,6) : 面ごとにブロック (1 辺 16 分割) 平均輝度が最大の方向 (粗い Key 方向)
//   MainRefineCS       (G,G,6) : 粗い方向の周りのコーン内で輝度重心の部分和 (Key 方向の精密化)
//   MainRefineReduceCS (1,1,1) : 部分和を合計
//   MainZonesCS        (G,G,6) : 全ゾーンの部分和
//   MainZonesReduceCS  (1,1,1) : 部分和を合計
//   G = clamp(ceil(N / 16), 1, 8)。グループを多く出して GPU 全体を使う
//
// 出力バッファ (float4):
//   [0..5]       : 面ごとのピーク (dir.xyz, 平均輝度)
//   [6]          : 重心の合計 (Σ lum·dir·dΩ, Σ lum·dΩ)
//   [8..23]      : ゾーンの合計 (Σ L·m·g·dΩ の rgb, Σ m·dΩ)      ← CPU に読み戻すのはここまで
//   [24..]       : 重心の部分和 (グループごと)
//   [24+384..]   : ゾーンの部分和 (グループごと × MAX_ZONES)

#include "/Engine/Public/Platform.ush"

#define MAX_ZONES 16
#define THREADS_X 16
#define THREADS_Y 16
#define NUM_THREADS (THREADS_X * THREADS_Y)
#define PI_F 3.14159265359f

// ゾーン形状 (C++ 側 ELightSyncZoneShape と一致させる)
#define ZONE_IRRADIANCE 0
#define ZONE_RING       1
#define ZONE_CONE       2
#define ZONE_SPHERE     3
#define ZONE_KEY        4
#define ZONE_EXCLUDE    5

// 入力: キューブ (通常) か、6 面を横に並べたアトラス (OCIO を掛けたもの。面 f は x = f*N .. f*N+N-1)
#ifndef INPUT_ATLAS
#define INPUT_ATLAS 0
#endif
TextureCube<float4> InputCube;
Texture2D<float4>   InputAtlas;
SamplerState        InputSampler;
RWStructuredBuffer<float4> OutputBuffer;

uint  TextureSize;
uint  GroupsPerSide;
uint  NumZones;
float PartitionSharpness;
float3 LuminanceCoeffs;

// xyz = 方向 (ワールド, 正規化済み), w = 形状
float4 ZoneDirShape[MAX_ZONES];
// x = cos(外側), y = cos(内側) (コーンのソフトエッジ), z = 方向を他ゾーンと分け合うか (1/0), w = 未使用
float4 ZoneParams[MAX_ZONES];

// 入力の伝達関数 (texel ごとにデコードしてから積分する。非線形なので積分後には掛けられない)
//   0 = リニア, 1 = sRGB EOTF, 2 = ガンマ 2.2, 3 = ガンマ 2.4, 4 = PQ (ST 2084), 5 = 任意のガンマ (DecodeGamma)
uint InputTransfer;

// InputTransfer = 5 のガンマ
float DecodeGamma;

// InputTransfer = 4 のとき: 10000 / 基準白 (nits)。PQ のコード値を「1.0 = 基準白」に直す
float PQScale;

// デコード後に掛ける補正ガンマ (壁の実際の応答。キャリブレーションで求める。1 = なし)
float TransferGamma;

// 精密化に使うコーンの cos (最初の Key ゾーンの外縁。Key が無ければ 2 = 無効)
float KeyRefineCos;

#define REFINE_TOTAL 6u
#define ZONES_TOTAL 8u
#define MAX_GROUPS (6u * 8u * 8u)
#define REFINE_PARTIALS (ZONES_TOTAL + MAX_ZONES)
#define ZONE_PARTIALS (REFINE_PARTIALS + MAX_GROUPS)

groupshared float4 gs_Reduce[NUM_THREADS];

// -------------------------------------------------------------------
// Face UV [0,1]^2 → 方向 (D3D キューブマップ規約。UE は世界方向でそのままサンプリングする)
// -------------------------------------------------------------------
float3 FaceUVToDirection(uint face, float2 uv)
{
    float s = uv.x * 2.0f - 1.0f;
    float t = uv.y * 2.0f - 1.0f;

    switch (face)
    {
        case 0u: return float3( 1.0f, -t,   -s  ); // +X
        case 1u: return float3(-1.0f, -t,    s  ); // -X
        case 2u: return float3( s,     1.0f, t  ); // +Y
        case 3u: return float3( s,    -1.0f, -t ); // -Y
        case 4u: return float3( s,    -t,    1.0f); // +Z
        default: return float3(-s,    -t,   -1.0f); // -Z
    }
}

float TexelSolidAngle(float2 uv)
{
    float s = uv.x * 2.0f - 1.0f;
    float t = uv.y * 2.0f - 1.0f;
    float d = 1.0f + s * s + t * t;
    return 4.0f / ((float)TextureSize * (float)TextureSize * d * sqrt(d));
}

float ConeMask(uint z, float3 dir, float3 axis)
{
    return smoothstep(ZoneParams[z].x, ZoneParams[z].y, dot(dir, axis));
}

// 除外コーンによる残存率 (除外は全ゾーンとピーク探索に効く)
float ExclusionKeep(float3 dir)
{
    float keep = 1.0f;
    for (uint z = 0; z < NumZones; ++z)
    {
        if ((uint)ZoneDirShape[z].w == ZONE_EXCLUDE)
        {
            keep *= 1.0f - ConeMask(z, dir, ZoneDirShape[z].xyz);
        }
    }
    return keep;
}

float3 DecodeTransfer(float3 v)
{
    if (InputTransfer == 1u)
    {
        v = max(v, 0.0f);
        // step(v, a) = (a >= v) ? 1 : 0
        return lerp(pow((v + 0.055f) / 1.055f, 2.4f), v / 12.92f, step(v, 0.04045f));
    }
    if (InputTransfer == 2u)
    {
        return pow(max(v, 0.0f), 2.2f);
    }
    if (InputTransfer == 3u)
    {
        return pow(max(v, 0.0f), 2.4f);
    }
    if (InputTransfer == 4u)
    {
        // SMPTE ST 2084 EOTF (0-1 = 0-10000 nits)
        const float m1 = 2610.0f / 16384.0f;
        const float m2 = 2523.0f / 4096.0f * 128.0f;
        const float c1 = 3424.0f / 4096.0f;
        const float c2 = 2413.0f / 4096.0f * 32.0f;
        const float c3 = 2392.0f / 4096.0f * 32.0f;
        float3 p = pow(saturate(v), 1.0f / m2);
        return pow(max(p - c1, 0.0f) / (c2 - c3 * p), 1.0f / m1) * PQScale;
    }
    if (InputTransfer == 5u)
    {
        return pow(max(v, 0.0f), DecodeGamma);
    }
    return v;
}

float3 LoadRadiance(uint face, uint x, uint y, float3 dir)
{
#if INPUT_ATLAS
    float3 L = DecodeTransfer(InputAtlas.Load(int3(face * TextureSize + x, y, 0)).rgb);
#else
    float3 L = DecodeTransfer(InputCube.SampleLevel(InputSampler, dir, 0).rgb);
#endif
    if (TransferGamma != 1.0f)
    {
        L = pow(max(L, 0.0f), TransferGamma);
    }
    // NaN / 負値 / Inf を抑える (積分全体が壊れないように)。max は NaN に対して 0 を返す
    return clamp(L, 0.0f, 65504.0f);
}

// Peak: 1 グループ / 面。スレッド = 1 辺 16 分割のブロック (CPU 版と同じ分割)
void PeakRange(uint2 tid, out uint2 start, out uint2 end)
{
    uint per = max(1u, (TextureSize + THREADS_X - 1u) / THREADS_X);
    start = tid * per;
    end = min(start + per, uint2(TextureSize, TextureSize));
}

// Refine / Zones: G×G グループ / 面。全スレッドで面を等分する
void GridRange(uint2 groupId, uint2 tid, out uint2 start, out uint2 end)
{
    uint threadsPerSide = THREADS_X * GroupsPerSide;
    uint per = max(1u, (TextureSize + threadsPerSide - 1u) / threadsPerSide);
    start = (groupId * THREADS_X + tid) * per;
    end = min(start + per, uint2(TextureSize, TextureSize));
}

uint GroupLinear(uint3 groupId)
{
    return (groupId.z * GroupsPerSide + groupId.y) * GroupsPerSide + groupId.x;
}

// グループ内の合計 (全スレッドが呼ぶこと)
float4 GroupSum(uint GroupIndex, float4 value)
{
    gs_Reduce[GroupIndex] = value;
    GroupMemoryBarrierWithGroupSync();
    for (uint stride = NUM_THREADS / 2u; stride > 0u; stride >>= 1u)
    {
        if (GroupIndex < stride)
        {
            gs_Reduce[GroupIndex] += gs_Reduce[GroupIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }
    float4 result = gs_Reduce[0];
    GroupMemoryBarrierWithGroupSync();
    return result;
}

float4 CoarsePeak()
{
    float4 peak = OutputBuffer[0];
    for (uint f = 1u; f < 6u; ++f)
    {
        float4 p = OutputBuffer[f];
        if (p.w > peak.w)
        {
            peak = p;
        }
    }
    return peak;
}

// -------------------------------------------------------------------
// Pass 1: ピーク探索 (スレッドごとのブロック平均輝度の最大)
// -------------------------------------------------------------------
[numthreads(THREADS_X, THREADS_Y, 1)]
void MainPeakCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
    const uint face = GroupId.z;
    uint2 start, end;
    PeakRange(GroupThreadId.xy, start, end);

    float  lumSum = 0.0f;
    float  omegaSum = 0.0f;
    float3 dirSum = 0.0f;

    for (uint y = start.y; y < end.y; ++y)
    {
        for (uint x = start.x; x < end.x; ++x)
        {
            float2 uv = (float2(x, y) + 0.5f) / (float)TextureSize;
            float3 dir = normalize(FaceUVToDirection(face, uv));
            float dOmega = TexelSolidAngle(uv) * ExclusionKeep(dir);
            float lum = dot(LoadRadiance(face, x, y, dir), LuminanceCoeffs);
            lumSum += lum * dOmega;
            omegaSum += dOmega;
            dirSum += dir * lum * dOmega;
        }
    }

    float meanLum = omegaSum > 0.0f ? lumSum / omegaSum : 0.0f;
    float3 peakDir = dot(dirSum, dirSum) > 0.0f ? normalize(dirSum) : float3(0.0f, 0.0f, 1.0f);
    gs_Reduce[GroupIndex] = float4(peakDir, meanLum);
    GroupMemoryBarrierWithGroupSync();

    for (uint stride = NUM_THREADS / 2u; stride > 0u; stride >>= 1u)
    {
        if (GroupIndex < stride && gs_Reduce[GroupIndex + stride].w > gs_Reduce[GroupIndex].w)
        {
            gs_Reduce[GroupIndex] = gs_Reduce[GroupIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (GroupIndex == 0u)
    {
        OutputBuffer[face] = gs_Reduce[0];
    }
}

// -------------------------------------------------------------------
// Pass 2: Key 方向の精密化 (粗いピークの周りのコーン内で輝度重心の部分和)
// -------------------------------------------------------------------
[numthreads(THREADS_X, THREADS_Y, 1)]
void MainRefineCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
    const uint face = GroupId.z;
    float4 peak = CoarsePeak();
    float4 acc = 0.0f;

    if (peak.w > 0.0f && KeyRefineCos <= 1.0f)
    {
        uint2 start, end;
        GridRange(GroupId.xy, GroupThreadId.xy, start, end);
        for (uint y = start.y; y < end.y; ++y)
        {
            for (uint x = start.x; x < end.x; ++x)
            {
                float2 uv = (float2(x, y) + 0.5f) / (float)TextureSize;
                float3 dir = normalize(FaceUVToDirection(face, uv));
                if (dot(dir, peak.xyz) < KeyRefineCos)
                {
                    continue;
                }
                float w = dot(LoadRadiance(face, x, y, dir), LuminanceCoeffs) * TexelSolidAngle(uv) * ExclusionKeep(dir);
                acc += float4(dir * w, w);
            }
        }
    }

    float4 sum = GroupSum(GroupIndex, acc);
    if (GroupIndex == 0u)
    {
        OutputBuffer[REFINE_PARTIALS + GroupLinear(GroupId)] = sum;
    }
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainRefineReduceCS(uint GroupIndex : SV_GroupIndex)
{
    const uint count = 6u * GroupsPerSide * GroupsPerSide;
    float4 acc = 0.0f;
    for (uint i = GroupIndex; i < count; i += NUM_THREADS)
    {
        acc += OutputBuffer[REFINE_PARTIALS + i];
    }
    float4 sum = GroupSum(GroupIndex, acc);
    if (GroupIndex == 0u)
    {
        OutputBuffer[REFINE_TOTAL] = sum;
    }
}

// -------------------------------------------------------------------
// Pass 3: ゾーン積分 (部分和)
// -------------------------------------------------------------------
[numthreads(THREADS_X, THREADS_Y, 1)]
void MainZonesCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
    const uint face = GroupId.z;

    // 粗いピーク → 精密化した重心方向
    float4 peak = CoarsePeak();
    float4 refine = OutputBuffer[REFINE_TOTAL];
    float3 keyDir = (refine.w > 0.0f && dot(refine.xyz, refine.xyz) > 0.0f) ? normalize(refine.xyz) : peak.xyz;
    bool bHasKey = peak.w > 0.0f;

    float4 acc[MAX_ZONES];
    for (uint i = 0; i < MAX_ZONES; ++i)
    {
        acc[i] = 0.0f;
    }

    uint2 start, end;
    GridRange(GroupId.xy, GroupThreadId.xy, start, end);

    for (uint y = start.y; y < end.y; ++y)
    {
        for (uint x = start.x; x < end.x; ++x)
        {
            float2 uv = (float2(x, y) + 0.5f) / (float)TextureSize;
            float3 dir = normalize(FaceUVToDirection(face, uv));
            float dOmega = TexelSolidAngle(uv);
            float3 L = LoadRadiance(face, x, y, dir);
            float keep = ExclusionKeep(dir);

            // 分割ゾーンの親和度
            float affinity[MAX_ZONES];
            float affinitySum = 0.0f;
            for (uint z = 0; z < MAX_ZONES; ++z)
            {
                affinity[z] = 0.0f;
                if (z >= NumZones || ZoneParams[z].z < 0.5f)
                {
                    continue;
                }
                uint shape = (uint)ZoneDirShape[z].w;
                float3 d = ZoneDirShape[z].xyz;
                float a = 0.0f;
                if (shape == ZONE_IRRADIANCE)
                {
                    a = max(0.0f, dot(dir, d));
                }
                else if (shape == ZONE_RING)
                {
                    float c = dot(dir, d);
                    a = sqrt(saturate(1.0f - c * c));
                }
                else if (shape == ZONE_CONE)
                {
                    a = ConeMask(z, dir, d);
                }
                affinity[z] = pow(max(a, 0.0f), PartitionSharpness);
                affinitySum += affinity[z];
            }

            for (uint z2 = 0; z2 < MAX_ZONES; ++z2)
            {
                if (z2 >= NumZones)
                {
                    break;
                }
                uint shape = (uint)ZoneDirShape[z2].w;
                if (shape == ZONE_EXCLUDE)
                {
                    continue;
                }
                float3 d = ZoneDirShape[z2].xyz;
                bool bShared = ZoneParams[z2].z > 0.5f && shape != ZONE_SPHERE && shape != ZONE_KEY;

                // 所属度 m
                float m;
                if (bShared)
                {
                    m = affinitySum > 0.0f ? affinity[z2] / affinitySum : 0.0f;
                }
                else if (shape == ZONE_CONE)
                {
                    m = ConeMask(z2, dir, d);
                }
                else if (shape == ZONE_KEY)
                {
                    m = bHasKey ? ConeMask(z2, dir, keyDir) : 0.0f;
                }
                else
                {
                    m = 1.0f;
                }
                m *= keep;

                // 形状の重み g
                float g;
                if (shape == ZONE_RING)
                {
                    float c = dot(dir, d);
                    g = sqrt(saturate(1.0f - c * c)) / (PI_F * PI_F);
                }
                else if (shape == ZONE_SPHERE)
                {
                    g = 1.0f / (4.0f * PI_F);
                }
                else
                {
                    float3 axis = (shape == ZONE_KEY) ? keyDir : d;
                    g = max(0.0f, dot(dir, axis)) / PI_F;
                }

                acc[z2].rgb += L * (m * g * dOmega);
                acc[z2].a   += m * dOmega;
            }
        }
    }

    // ゾーンごとにグループ内で合計して部分和として書き出す
    const uint groupLinear = GroupLinear(GroupId);
    // ループの回数は定数にする (バリアを含むので、コンパイラが一様と判断できる形にする)。使わないゾーンは 0 の和
    for (uint z3 = 0; z3 < MAX_ZONES; ++z3)
    {
        float4 sum = GroupSum(GroupIndex, acc[z3]);
        if (GroupIndex == 0u)
        {
            OutputBuffer[ZONE_PARTIALS + groupLinear * MAX_ZONES + z3] = sum;
        }
    }
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainZonesReduceCS(uint GroupIndex : SV_GroupIndex)
{
    const uint count = 6u * GroupsPerSide * GroupsPerSide;
    for (uint z = 0; z < NumZones; ++z)
    {
        float4 acc = 0.0f;
        for (uint i = GroupIndex; i < count; i += NUM_THREADS)
        {
            acc += OutputBuffer[ZONE_PARTIALS + i * MAX_ZONES + z];
        }
        float4 sum = GroupSum(GroupIndex, acc);
        if (GroupIndex == 0u)
        {
            OutputBuffer[ZONES_TOTAL + z] = sum;
        }
    }
}

// -------------------------------------------------------------------
// キューブ → 面アトラス (OCIO を掛ける前の並べ替え)。texel の向きは FaceUVToDirection と同じ
// -------------------------------------------------------------------
RWTexture2D<float4> AtlasOutput;

[numthreads(8, 8, 1)]
void MainCubeToAtlasCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint face = DispatchThreadId.z;
    if (DispatchThreadId.x >= TextureSize || DispatchThreadId.y >= TextureSize)
    {
        return;
    }
    float2 uv = (float2(DispatchThreadId.xy) + 0.5f) / (float)TextureSize;
    float3 dir = normalize(FaceUVToDirection(face, uv));
    AtlasOutput[uint2(face * TextureSize + DispatchThreadId.x, DispatchThreadId.y)] = InputCube.SampleLevel(InputSampler, dir, 0);
}
