{
	"FileVersion": 3,
	"Version": 4,
	"VersionName": "2.1",
	"FriendlyName": "LightSync DMX",
	"Description": "VP用 - プローブ位置の光を立体角で正しくゾーン積分し、灯体プロファイルとソルバでカメラ上の色を一致させて DMX/OSC 出力。LEDウォール基準/シーン基準、カメラだけのキャリブレーション、nDisplay のグレーディング・OCIO 連携に対応。",
	"Category": "Virtual Production",
	"CreatedBy": "UE-Comp",
	"CreatedByURL": "",
	"DocsURL": "https://github.com/Seraf0-org/LightSyncDMX#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/Seraf0-org/LightSyncDMX/issues",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": true,
	"EnabledByDefault": true,
	"EngineVersion": "5.7.0",
	"SupportedTargetPlatforms": [ "Win64" ],
	"Modules": [
		{
			"Name": "LightSyncDMX",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"AdditionalDependencies": [
				"Engine",
				"CoreUObject"
			]
		},
		{
			"Name": "LightSyncDMXEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"AdditionalDependencies": [
				"Engine",
				"UnrealEd"
			]
		}
	],
	"Plugins": [
		{
			"Name": "DMXProtocol",
			"Enabled": true
		},
		{
			"Name": "DMXEngine",
			"Enabled": true
		},
		{
			"Name": "OSC",
			"Enabled": true
		},
		{
			"Name": "OpenColorIO",
			"Enabled": true
		}
	]
}
